{
    name: "jvbuild",
    description: "JSON5-based and language-agnostic package manager, build system, and distribution tool.",
    author: "VExcess <github.com/vexcess>",
    repository: "https://github.com/vExcess/jvbuild",
    license: "MIT",
    
    modules: {
        jvbuild: {
            version: "1.7.0",
            root: "src/jvbuild.dart",
            dependencies: [
                "json5",
                "image",
                "http"
            ],
            weak_dependencies: [
                "dpkg",
                "rpm"
            ]
        },

        json5: {
            type: "dart:lib",
            version: "^0.8.2"
        },

        http: {
            type: "dart:lib",
            version: "^1.5.0"
        },

        image: {
            type: "dart:lib",
            version: "^4.5.4"
        },

        dpkg: {
            type: "system:lib",
            install: {
                debian_ubuntu: "sudo apt-get install dpkg",
                fedora: "sudo dnf install dpkg"
            }
        },

        rpm: {
            type: "system:lib",
            install: {
                debian_ubuntu: "sudo apt-get install rpm",
                fedora: "sudo dnf install rpmbuild"
            }
        },

    },

    default: "jvbuild"
}